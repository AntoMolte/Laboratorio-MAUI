<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaAPP.MainPage">

    <CollectionView x:Name="PizzeList">
        <CollectionView.ItemTemplate>
            <DataTemplate xmlns:models="clr-namespace:PizzaAPP.Models">
                <Grid Padding="12,8" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{Binding Nome}"
                               FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Ingredienti}"
                               FontSize="12" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding PrezzoFormattato}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#1A5276"
                           VerticalOptions="Center"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>


</ContentPage>
