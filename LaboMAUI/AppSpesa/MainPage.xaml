<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSpesa.MainPage"
             xmlns:local="clr-namespace:AppSpesa">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="LE MIE SPESE"
               FontSize="32"
               HorizontalOptions="Center"
               FontAttributes="Bold"
               TextColor="Blue"/>

            <Entry Placeholder="Nome lista (es.marzo)"
                    x:Name="EntNomeLista"
                    WidthRequest="1000"
                    HorizontalOptions="Center"/>

            <Entry Placeholder="Descrizione spesa"
                    x:Name="EntDescrizione"
                    WidthRequest="1000"
                    HorizontalOptions="Center"/>

            <Entry Placeholder="Importo"
                   x:Name="EntImporto"
                   WidthRequest="1000"
                   HorizontalOptions="Center"
                   Keyboard="Numeric"/>

            <Entry Placeholder="Quantità"
                   x:Name="EntQuantita"
                   WidthRequest="1000"
                   HorizontalOptions="Center"
                   Keyboard="Numeric"/>

            <Button Text="SALVA SPESA"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    WidthRequest="1000"
                    Clicked="OnSalvaClicked"
                    Background="Green"/>

            <Button Text="VEDI SPESA"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    WidthRequest="1000"
                    Clicked="OnVediClicked"
                    Background="LightBlue"/>

            <Label Text="Liste salva"
                   FontSize="16"
                   FontAttributes="Italic"
                   HorizontalTextAlignment="Center"
                   Margin="0, 15, 0, 0"
                   TextColor="LightGray"/>

            <Editor x:Name="VediListe"
                    IsReadOnly="True"
                    HeightRequest="150"
                    WidthRequest="1000"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontAttributes="Italic"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>