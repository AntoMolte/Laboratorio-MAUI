<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppQuiz.ResultPage"
    Title="Risultato">

    <VerticalStackLayout 
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label 
            Text="Quiz Terminato!"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label 
            x:Name="ScoreLabel"
            Text="Punteggio: 0"
            FontSize="22"
            HorizontalOptions="Center" />
        <Button 
            Text="Torna al Quiz"
            Clicked="OnRestartClicked"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>
