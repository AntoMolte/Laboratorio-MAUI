<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSpese.DettaglioPage"
             Title="DettaglioPage">
    <ScrollView>
        <VerticalStackLayout
         Padding="30,0"
         Spacing="25">

            <Label Text="Dettaglio spese"/>
            <Label x:Name="LblNome"/>

            <Editor x:Name="EdiListaSpesa" IsReadOnly="True"/>

            <Button Clicked="OnBackClicked" Text="Torna Indietro"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>